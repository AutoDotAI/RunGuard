# Copy to .env, then replace this value with: openssl rand -hex 32
RUNGUARD_AUTH_SECRET=

# Required by the local PostgreSQL service. Generate independently with: openssl rand -hex 32
RUNGUARD_POSTGRES_PASSWORD=
# Optional host-worker connection settings (the default port binds only to loopback).
# RUNGUARD_POSTGRES_PORT=5432

# Optional: only the worker receives provider settings from this file.
# RUNGUARD_MODEL_PROVIDER=litellm
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
