# Copy to .env.production on the single deployment host. Never commit its values.
RUNGUARD_PUBLIC_HOST=demo.example.org
RUNGUARD_ALLOWED_HOSTS=www.python.org,www.example.com
RUNGUARD_AUTH_SECRET=
# Set both model and provider key only when live summaries have been tested.
RUNGUARD_SUMMARIZER_AVAILABLE=false
LLM_MODEL=
OPENAI_API_KEY=
# Dedicated deployment smoke account; use a strong, unique password.
RUNGUARD_SMOKE_EMAIL=smoke@example.org
RUNGUARD_SMOKE_PASSWORD=
